# ============================================================
# Financial Decision Intelligence — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env
# ============================================================

# Database
DATABASE_URL=postgresql+asyncpg://financeapp:financeapp_dev@localhost:5432/financeapp
DATABASE_URL_SYNC=postgresql://financeapp:financeapp_dev@localhost:5432/financeapp
REDIS_URL=redis://localhost:6379/0
CLICKHOUSE_URL=http://localhost:8123

# Auth
SECRET_KEY=change-me-to-a-random-string-min-32-chars-long
FIELD_ENCRYPTION_KEY=change-me-to-a-fernet-key

# AI Providers
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_URL=http://localhost:11434

# App
APP_ENV=development
APP_VERSION=1.0.0
APP_NAME=FinanceApp
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
SAFETY_BUFFER_USD=500
LOG_LEVEL=INFO

# Email (security alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Postgres (used by docker-compose)
POSTGRES_USER=financeapp
POSTGRES_PASSWORD=financeapp_dev
POSTGRES_DB=financeapp
